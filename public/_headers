# Headers for the static app. Cloudflare applies the matching block to the asset it serves.
#
# The policy is tight because the app is self-contained: no third-party scripts, no remote fonts,
# no measurement. A view added later that calls a host must add it to connect-src; a measurement
# script must add its origin to script-src and connect-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

# Vite's filenames carry a content hash, so an asset at a given URL never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Every place is the same document, so it is revalidated or a deploy stays invisible.
/
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=86400
