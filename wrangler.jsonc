{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowline",
  "compatibility_date": "2026-10-19",

  // The static build, served from the edge. When the workspace gets a server, this file gains
  // `main` and `run_worker_first` for /api and /ws: one Worker, one origin, no CORS.
  "main": "./worker/index.ts",

  "assets": {
    "directory": "./dist",
    // The API is the only path the script answers; everything else is served by the asset router
    // without it running at all.
    // The API, and the app's own document: a place in the board is a query string, so every path
    // under `/app` is the same file and the Worker is what hands it over (task 151).
    "run_worker_first": ["/api/*", "/app", "/app/*", "/mcp", "/scim/*"],
    "binding": "ASSETS",
    // Unknown paths answer the site's 404 page with a 404 (task 151). The app used to own the
    // fallback, because every place was a query on `/`; now the app is under `/app` — where
    // `_redirects` sends any path to its document — and everything else is the site.
    "not_found_handling": "404-page"
  },

  // The live channel: one Durable Object per workspace, holding the sockets that say "the feed
  // moved". Without this binding the clients poll the same feed and nothing else changes — which is
  // what a self-hosted instance does with its own socket server.
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE_CHANNEL", "class_name": "WorkspaceChannel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceChannel"] }],

  // Preview versions get their own URL, which is what a pull request deploys.
  "preview_urls": true,
  "previews": {},
  "observability": { "enabled": true }

  // The database. Create it once, then uncomment this block with the id the command prints:
  //   npx wrangler d1 create flowline-errors
  //   npx wrangler d1 migrations apply flowline-errors --remote
  //
  // This file is **this project's own deployment** — the site and the demo at
  // flowline.flowline-team.workers.dev. It is not how you self-host: a team cloning the repository runs
  // `docker compose up -d` and never opens this file (docs/install.md).
  //
  // Uncommenting the block below is what turns *this* deployment from the site and demo into an
  // instance: accounts, sessions, invitations and passwords all live in that database, and without it
  // every route that needs one answers 503 while the demo keeps working from localStorage.
  //
  // If you are deliberately deploying an instance on Workers, read the CPU note in
  // docs/server-runtime.md first. On the free plan one PBKDF2 password check (~60 ms) is six times the
  // 10 ms CPU budget a request is given, and the password door answers 1102 instead of signing anybody
  // in. The paid plan, the Node entry and an identity provider are the three ways out; the note has all
  // three, and the container is the easy one.
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "flowline-errors",
  //     "database_id": "<the id from wrangler d1 create>",
  //     "migrations_dir": "migrations"
  //   }
  // ]
}
