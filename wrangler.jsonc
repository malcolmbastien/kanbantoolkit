{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowline",
  "compatibility_date": "2026-10-19",

  // The static build, served from the edge. When the workspace gets a server, this file gains
  // `main` and `run_worker_first` for /api and /ws: one Worker, one origin, no CORS.
  "main": "./worker/index.ts",

  "assets": {
    "directory": "./dist",
    // The API is the only path the script answers; everything else is served by the asset router
    // without it running at all.
    // The API, and the app's own document: a place in the board is a query string, so every path
    // under `/app` is the same file and the Worker is what hands it over (task 151).
    "run_worker_first": ["/api/*", "/app", "/app/*"],
    "binding": "ASSETS",
    // Unknown paths answer the site's 404 page with a 404 (task 151). The app used to own the
    // fallback, because every place was a query on `/`; now the app is under `/app` — where
    // `_redirects` sends any path to its document — and everything else is the site.
    "not_found_handling": "404-page"
  },

  // The live channel: one Durable Object per workspace, holding the sockets that say "the feed
  // moved". Without this binding the clients poll the same feed and nothing else changes — which is
  // what a self-hosted instance does with its own socket server.
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE_CHANNEL", "class_name": "WorkspaceChannel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceChannel"] }],

  // Preview versions get their own URL, which is what a pull request deploys.
  "preview_urls": true,
  "previews": {},
  "observability": { "enabled": true }

  // The error log. Create it once, then uncomment this block with the id the command prints:
  //   npx wrangler d1 create flowline-errors
  //   npx wrangler d1 migrations apply flowline-errors --remote
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "flowline-errors",
  //     "database_id": "<the id from wrangler d1 create>",
  //     "migrations_dir": "migrations"
  //   }
  // ]
}
