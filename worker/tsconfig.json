{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/workers-types"
    ],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "tsBuildInfoFile": "../node_modules/.tmp/worker.tsbuildinfo"
  },
  "include": [
    ".",
    "../server/**/*.ts"
  ],
  /* The Node entry and its driver, and the tests that use them, are the other project. */
  "exclude": [
    "../server/index.node.ts",
    "../server/sqlite.ts",
    "../server/**/*.test.ts"
  ]
}
