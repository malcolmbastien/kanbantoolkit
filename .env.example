# Kanban Toolkit — example env. Copy to .env and fill in.
# Taskmaster AI provider: any OpenAI-compatible endpoint.
# Default here is the OpenCode Go gateway (https://opencode.ai/zen/go/v1).
OPENAI_COMPATIBLE_API_KEY=sk-...

# The instance's salt, which `docker compose up` requires. Generate it once with
# `openssl rand -hex 32` and uncomment the line; a published value is not a secret.
# ERROR_SALT=
