{
  "name": "flowline",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-site.ts",
    "size": "node scripts/bundle-size.mjs",
    "smoke:node": "node scripts/smoke-node.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "server": "tsx server/index.node.ts",
    "backup": "tsx server/backup.ts",
    "deploy": "npm run build && wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "taskmaster:proxy": "node scripts/opencode-go-proxy.mjs",
    "scan": "bash scripts/scan-deps.sh",
    "portable": "bash scripts/check-portable.sh",
    "test:e2e": "playwright test",
    "site:check": "node scripts/check-site.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "shots": "tsx scripts/shots.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^0.475.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.15",
    "wrangler": "^4.151.2"
  }
}
